# `pnpm dev:mock`: the real API over the SDK's in-memory Walrus mock, for frontend work. No keys needed.
# Nothing here reaches Walrus, Sui, Tatum, an LLM or Telegram. The server refuses this mode in production.
MEMORY_MODE=mock
AUTH=off
APP_SECRET=mock-only-not-a-secret
TELEGRAM_MODE=off
PGLITE_DIR=memory
MOCK_SEED=1
CEO_TIMEZONE=Asia/Ho_Chi_Minh
PORT=8787
