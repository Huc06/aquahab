# Aquahab crew server. Copy to .env.local (never commit it). `pnpm keys` fills the keys and secrets for you.

# --- Walrus Memory (mainnet) ---
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_ACCOUNT_ID=                 # written by `pnpm account create`
AQUAHAB_OWNER_ADDRESS=             # the account owner's Sui address (public)
# One Ed25519 delegate key per crew member. Each signs the memories it files. Written by `pnpm keys`.
MEMWAL_KEY_ONE=
MEMWAL_KEY_RESEARCHER=
MEMWAL_KEY_BUILDER=
MEMWAL_KEY_LOFI=
MEMWAL_KEY_HIPPO=
MEMWAL_KEY_KEEPER=
# The OWNER key lives in .env.owner.local, is used only by `pnpm account`, and is never deployed.

# --- Tatum (Sui mainnet reads, and hires/fires) ---
TATUM_API_KEY=                     # dashboard.tatum.io, the mainnet key of the account named on the form

# --- LLM (pick one; without any, the crew uses deterministic fallbacks) ---
# Local and free, like Tact: install Ollama, `ollama pull llama3.1:8b`, then
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# Any OpenAI-compatible API (Groq, OpenRouter, Google Gemini's OpenAI endpoint, LM Studio):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# Vercel AI Gateway (vercel.com → AI Gateway → API keys):
# AI_GATEWAY_API_KEY=
# LLM_MODEL=anthropic/claude-sonnet-5.5
# LLM_FAST_MODEL=anthropic/claude-haiku-5.5

# --- Telegram ---
TELEGRAM_BOT_TOKEN=                # @BotFather
TELEGRAM_MODE=poll                 # poll (local), webhook (deployed) or off
TELEGRAM_PAIR_CODE=                # the CEO sends /start <code> once to bind their chat
TELEGRAM_WEBHOOK_SECRET=           # webhook mode: Telegram sends it back on every update
# TELEGRAM_WEBHOOK_URL=            # webhook mode, optional: defaults to ${APP_URL}/telegram/webhook (the web app proxies it)

# --- App ---
APP_URL=http://localhost:3000      # the web app (it proxies /api to this server)
APP_SECRET=                        # signs sessions and private-room aliases; never change after the first room
CRON_SECRET=                       # bearer for POST /api/cron/tick on serverless hosts
CEO_API_TOKEN=                     # bearer for scripts that call write endpoints
CEO_TIMEZONE=Asia/Ho_Chi_Minh
PORT=8787
# DATABASE_URL=                    # Postgres when deployed (required in production): Railway Postgres or Neon. PGlite in ./data when unset
# MEMORY_MODE=mock                 # local UI work only: in-memory Walrus mock. Refused in production.
# AUTH=off                         # local UI work only. Refused in production.
