{
  "name": "aquahab-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/main.ts",
    "start": "tsx --env-file-if-exists=.env.local src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "keys": "tsx --env-file-if-exists=.env.local scripts/keys.ts",
    "account": "tsx --env-file-if-exists=.env.local scripts/account.ts",
    "probe": "tsx --env-file-if-exists=.env.local scripts/probe.ts",
    "verify": "tsx --env-file-if-exists=.env.local scripts/verify.ts",
    "telegram:poll": "tsx --env-file-if-exists=.env.local scripts/telegram-poll.ts",
    "contract:sync": "node scripts/sync-contract.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@hono/node-server": "^2.1.6",
    "@mysten-incubation/memwal": "0.1.12",
    "@mysten/seal": "^1.5.2",
    "@mysten/sui": "^2.38.0",
    "@neondatabase/serverless": "^1.2.0",
    "@protobuf-ts/grpc-transport": "2.11.1",
    "ai": "^7.0.162",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
